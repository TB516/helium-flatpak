#!/bin/sh
set -eu

# Use the exact deployment mounted at /app, including for local builds.
# Flatpak stores this host path as an escaped key-file string.
app_path=$(printf '%b' "$(sed -n 's/^app-path=//p' /.flatpak-info)")
if [ -z "$app_path" ]; then
    echo "Could not find Helium's host path in /.flatpak-info." >&2
    exit 1
fi

# Unlike app_path, Flatpak's exported launcher keeps its path across updates.
launcher=${app_path%/app/net.imput.helium/*}/exports/bin/net.imput.helium

# Helium uses the host's XDG directories like any host app, so desktop
# settings and default apps work. Only its profile and cache stay in the
# Flatpak data directory. Arguments passed later can still override them.
# Crash reports ignore --user-data-dir, so they need their own location.
exec flatpak-spawn --host \
    --env=BREAKPAD_DUMP_LOCATION="$XDG_CONFIG_HOME/net.imput.helium/Crash Reports" \
    "$app_path/libexec/helium-host" \
    "$launcher" "$app_path/helium" \
    --user-data-dir="$XDG_CONFIG_HOME/net.imput.helium" \
    --disk-cache-dir="$XDG_CACHE_HOME/net.imput.helium" \
    "$@"
