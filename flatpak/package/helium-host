#!/bin/sh
set -eu

launcher=$1
helium_dir=$2
shift 2

# Match the exported desktop entry for Chromium's desktop integration.
export HELIUM_DESKTOP=net.imput.helium.desktop

# Fall back to the bundled xdg-utils on hosts without them.
PATH=$PATH:$(dirname "$0")/xdg-utils
export PATH

# The rest mirrors upstream's helium-wrapper, except CHROME_WRAPPER. Chromium
# writes it into web app shortcuts and relaunches with it, so it must point at
# a path that survives updates.
export CHROME_VERSION_EXTRA=custom
export CHROME_WRAPPER="$launcher"
export LD_LIBRARY_PATH="$helium_dir:$helium_dir/lib:$helium_dir/lib.target${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

exec "$helium_dir/helium" "$@"
