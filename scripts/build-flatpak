#!/usr/bin/env bash
set -euo pipefail

PROJECT_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
readonly PROJECT_ROOT
readonly APP_ID="net.imput.helium"
readonly MANIFEST="$PROJECT_ROOT/flatpak/$APP_ID.yml"
readonly BRANCH=stable
readonly OUTPUT="$PROJECT_ROOT/build-flatpak"
readonly BUILD_DIR="$OUTPUT/build"
readonly STATE_DIR="$OUTPUT/builder-state"
readonly REPO_DIR="$OUTPUT/repo"
readonly BUNDLE="$OUTPUT/$APP_ID.flatpak"
readonly RUNTIME_REPO="https://flathub.org/repo/flathub.flatpakrepo"

build() {
    mkdir -p "$OUTPUT"
    flatpak-builder \
        --user \
        --force-clean \
        --default-branch="$BRANCH" \
        --state-dir="$STATE_DIR" \
        --repo="$REPO_DIR" \
        "$BUILD_DIR" \
        "$MANIFEST"
    if [[ -e "$BUNDLE" ]]; then
        rm -- "$BUNDLE"
    fi
    flatpak build-bundle \
        --runtime-repo="$RUNTIME_REPO" \
        "$REPO_DIR" \
        "$BUNDLE" \
        "$APP_ID" \
        "$BRANCH"
    echo "Built $BUNDLE"
}

case "${1:-build}" in
    build)
        build
        ;;
    install)
        build
        flatpak --user install --or-update -y "$BUNDLE"
        ;;
    run)
        shift
        exec flatpak run --user --branch="$BRANCH" "$APP_ID" "$@"
        ;;
    *)
        echo "Usage: $0 [build|install|run]" >&2
        exit 2
        ;;
esac
